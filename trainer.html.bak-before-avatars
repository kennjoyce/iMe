<script>
const WEB3FORMS_KEY = "c9175657-3396-47b9-bf4b-696401950b90";
async function submitTrainerForm(e){
  e.preventDefault();
  var f=e.target;
  var name=f.name.value.trim();
  var msg=document.getElementById('formMsg');
  var btn=f.querySelector('button[type="submit"]');
  var data=new FormData(f);
  data.append('access_key', WEB3FORMS_KEY);
  data.append('subject', 'iMe Live Trainer enquiry — '+name+' ('+f.company.value.trim()+')');
  data.append('from_name', 'iMe Live Trainer — ime.ceo');
  msg.style.display='block';
  msg.style.background='rgba(201,168,76,0.10)';msg.style.border='1px solid rgba(201,168,76,0.35)';msg.style.color='#e0c164';
  msg.textContent='Sending your request…';
  if(btn) btn.disabled=true;
  try{
    var res=await fetch('https://api.web3forms.com/submit',{method:'POST',body:data});
    var out=await res.json();
    if(out.success){
      msg.textContent='Thank you, '+name+'. Your request has been sent — Kenn will be in touch shortly.';
      f.reset();
    } else { throw new Error(out.message||'send failed'); }
  }catch(err){
    msg.style.background='rgba(255,90,90,0.09)';msg.style.border='1px solid rgba(255,90,90,0.35)';msg.style.color='#ff9090';
    msg.textContent='Sorry — something went wrong. Please email kenn.joyce@aiadvisers.io directly.';
  }finally{ if(btn) btn.disabled=false; }
}
